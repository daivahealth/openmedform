# Database
POSTGRES_USER=openmedform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openmedform
DATABASE_URL=postgresql://openmedform:changeme@localhost:5432/openmedform?schema=public

# Auth
JWT_SECRET=changeme-to-a-secure-random-string
JWT_EXPIRY=24h

# App
PORT=3100
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3100
# Public origin of the web app. Used for canonical URLs, robots.txt and
# sitemap.xml, so it must be the externally reachable origin. Defaults to the
# production domain; override only for preview/staging deployments.
NEXT_PUBLIC_SITE_URL=https://openmedform.daiva.health

# Docker Compose (production)
# HTTP_PORT=80

# AI Provider Encryption
# Encrypts tenant LLM API keys at rest. REQUIRED — the app refuses to start
# without it, and refuses known placeholder values outright.
# Generate real key material rather than typing a passphrase:
#   openssl rand -hex 32
# A 64-char hex (or 32-byte base64) value is used directly; anything else is
# treated as a passphrase and stretched with scrypt, which cannot recover
# entropy the passphrase never had.
# AI_ENCRYPTION_KEY=

# AI Builder — configure one or more providers (env var fallback, optional if using Settings UI)
# AI_DEFAULT_PROVIDER=claude

# Anthropic Claude
# AI_CLAUDE_API_KEY=sk-ant-...
# AI_CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI
# AI_OPENAI_API_KEY=sk-...
# AI_OPENAI_MODEL=gpt-4o

# MiniMax
# AI_MINIMAX_API_KEY=...
# AI_MINIMAX_MODEL=abab6.5-chat

# Kimi (Moonshot)
# AI_KIMI_API_KEY=...
# AI_KIMI_MODEL=moonshot-v1-8k

# Ollama (local)
# AI_OLLAMA_BASE_URL=http://localhost:11434
# AI_OLLAMA_MODEL=llama3

# ─── SSO (optional) ──────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback
#
# Microsoft (Entra ID) — independent of Google; enable either, both or neither.
# https://entra.microsoft.com → App registrations → add the redirect URI below
# and create a client secret.
# MICROSOFT_TENANT controls which directories may sign in:
#   organizations  work/school accounts from any Azure tenant (default)
#   <tenant GUID>  only that one organisation
#   common         also personal Microsoft accounts (weaker identity signal)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=http://localhost:3100/api/auth/microsoft/callback
# MICROSOFT_TENANT=organizations

# SNOMED CT terminology server (FHIR). SNOMED is member-country licensed:
# configure this AND set snomedEnabled=true in a tenant's settings JSON to
# enable SNOMED search/suggestions for that tenant. Leave unset to keep
# SNOMED off everywhere. Example: a self-hosted Snowstorm/Ontoserver.
# SNOMED_FHIR_URL=
