{
  "name": "@openmedform/form-schema-types",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Framework-independent contract types for the OpenMedForm dual-engine form platform (Data / UI / Print schema, FormDefinition, FormInstance).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "prepack": "tsc"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
