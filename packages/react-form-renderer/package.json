{
  "name": "@openmedform/react-form-renderer",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "description": "React renderer for OpenMedForm form definitions. Import from '@openmedform/react-form-renderer/jsonforms' for the portable, Form.io-free JSON Forms renderer, or the package root for the dual-engine dispatcher.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepack": "tsc"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./jsonforms": {
        "types": "./dist/jsonforms.d.ts",
        "default": "./dist/jsonforms.js"
      }
    }
  },
  "dependencies": {
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@jsonforms/vanilla-renderers": "^3.8.0",
    "@openmedform/form-core": "workspace:*",
    "@openmedform/form-design-tokens": "workspace:*",
    "@openmedform/form-schema-types": "workspace:*"
  },
  "optionalDependencies": {
    "@openmedform/renderer": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daivahealth/openmedform.git",
    "directory": "packages/react-form-renderer"
  },
  "homepage": "https://github.com/daivahealth/openmedform/tree/main/packages/react-form-renderer#readme",
  "bugs": {
    "url": "https://github.com/daivahealth/openmedform/issues"
  }
}
