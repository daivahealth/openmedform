{
  "name": "@openmedform/form-core",
  "version": "1.5.0",
  "private": false,
  "license": "MIT",
  "description": "Framework-independent form engine core: JSON Schema (2020-12) validation, $ref/scope resolution, data binding, conditional-rule evaluation, i18n, the control-registry contract, and response serialization. No Angular/React dependencies.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepack": "tsc"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@openmedform/form-schema-types": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daivahealth/openmedform.git",
    "directory": "packages/form-core"
  },
  "homepage": "https://github.com/daivahealth/openmedform/tree/main/packages/form-core#readme",
  "bugs": {
    "url": "https://github.com/daivahealth/openmedform/issues"
  }
}
