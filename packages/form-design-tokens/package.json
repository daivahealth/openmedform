{
  "name": "@openmedform/form-design-tokens",
  "version": "1.4.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Shared visual/layout tokens (typography, spacing, borders, row heights, breakpoints) exposed as TS constants and CSS custom properties, consumed by BOTH the React and Angular renderers so the same FormDefinition renders equivalently across frameworks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc && cp src/tokens.css dist/tokens.css",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css"
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daivahealth/openmedform.git",
    "directory": "packages/form-design-tokens"
  },
  "homepage": "https://github.com/daivahealth/openmedform/tree/main/packages/form-design-tokens#readme",
  "bugs": {
    "url": "https://github.com/daivahealth/openmedform/issues"
  }
}
