{
  "name": "openmedform",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "build:packages": "pnpm --filter=@openmedform/form-schema-types --filter=@openmedform/form-core --filter=@openmedform/form-design-tokens --filter=@openmedform/react-form-renderer --filter=@openmedform/angular-form-renderer run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "db:migrate": "pnpm --filter @openmedform/api prisma:migrate",
    "db:seed": "pnpm --filter @openmedform/api prisma:seed",
    "db:studio": "pnpm --filter @openmedform/api prisma:studio"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  }
}
