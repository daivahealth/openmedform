{
  "name": "openmedform",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "build:packages": "pnpm --filter=@openmedform/form-schema-types --filter=@openmedform/form-core --filter=@openmedform/form-design-tokens --filter=@openmedform/react-form-renderer --filter=@openmedform/angular-form-renderer --filter=@openmedform/form-print-engine run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "db:migrate": "pnpm --filter @openmedform/api prisma:migrate",
    "db:seed": "pnpm --filter @openmedform/api prisma:seed",
    "db:studio": "pnpm --filter @openmedform/api prisma:studio"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "multer": ">=2.2.0",
      "tar": ">=7.5.19",
      "lodash": ">=4.18.1",
      "brace-expansion": ">=1.1.17",
      "immutable": ">=5.1.9",
      "fast-uri": ">=3.1.4",
      "sharp": ">=0.35.3",
      "postcss": ">=8.5.25",
      "nanoid@<3.3.17": ">=3.3.17",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
