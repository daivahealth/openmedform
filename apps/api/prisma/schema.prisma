generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum FormStatus {
  DRAFT
  CONVERTING
  REVIEW
  PUBLISHED
  ARCHIVED
  RETIRED

  @@map("form_status_enum")
}

enum ConversionJobStatus {
  PENDING
  RUNNING
  REVIEW
  COMPLETED
  FAILED

  @@map("conversion_job_status_enum")
}

enum FormType {
  PATIENT
  NON_PATIENT

  @@map("form_type_enum")
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  SIGNED
  AMENDED
  VOIDED

  @@map("submission_status_enum")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  FORM_DESIGNER
  CLINICIAN
  VIEWER

  @@map("user_role_enum")
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  country   String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  settings  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  users       User[]
  forms       Form[]
  submissions Submission[]

  @@map("tenant")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  fullName     String    @map("full_name") @db.VarChar(255)
  role         UserRole  @default(CLINICIAN)
  formLimit    Int?      @map("form_limit")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  createdForms Form[]       @relation("FormCreator")
  submissions  Submission[]

  @@unique([tenantId, email], name: "uq_user_tenant_email")
  @@index([tenantId])
  @@map("user")
}

// ─── Form ────────────────────────────────────────────────────────────────────

model Form {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  name             String     @db.VarChar(255)
  slug             String     @db.VarChar(255)
  description      String?    @db.Text
  category         String?    @db.VarChar(100)
  tags             String[]   @default([])
  formType         FormType   @default(PATIENT) @map("form_type")
  status           FormStatus @default(DRAFT)
  currentVersionId String?    @unique @map("current_version_id") @db.Uuid
  createdById      String     @map("created_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  createdBy      User            @relation("FormCreator", fields: [createdById], references: [id])
  versions       FormVersion[]
  currentVersion FormVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  submissions    Submission[]

  @@unique([tenantId, slug], name: "uq_form_tenant_slug")
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("form")
}

// ─── Form Version ────────────────────────────────────────────────────────────

model FormVersion {
  id           String     @id @default(uuid()) @db.Uuid
  formId       String     @map("form_id") @db.Uuid
  version      Int        @default(1)
  // Separated Data / UI / Print schemas — see ADR-004. Form.io's single coupled
  // `schema` column was dropped with the engine.
  dataSchema   Json?      @map("data_schema")
  uiSchema     Json?      @map("ui_schema")
  printSchema  Json?      @map("print_schema")
  translations Json?
  scoringRules Json?      @map("scoring_rules")
  metadata     Json?      @default("{}")
  conversionMetadata Json? @map("conversion_metadata")
  changelog    String?    @db.Text
  // SHA-256 of the canonical published payload; set at publish time and used to
  // detect tampering with an immutable published version.
  contentHash  String?    @map("content_hash") @db.VarChar(64)
  publishedAt  DateTime?  @map("published_at") @db.Timestamp(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  form        Form         @relation(fields: [formId], references: [id])
  currentOf   Form?        @relation("CurrentVersion")
  submissions Submission[]

  @@unique([formId, version], name: "uq_form_version")
  @@index([formId])
  @@map("form_version")
}

// ─── Submission ──────────────────────────────────────────────────────────────

model Submission {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  formId        String           @map("form_id") @db.Uuid
  formVersionId String           @map("form_version_id") @db.Uuid
  submittedById String           @map("submitted_by_id") @db.Uuid
  status        SubmissionStatus @default(IN_PROGRESS)
  data          Json
  scores        Json?            @default("{}")
  riskLevel     String?          @map("risk_level") @db.VarChar(50)
  patientMrn    String?          @map("patient_mrn") @db.VarChar(50)
  encounterId   String?          @map("encounter_id") @db.VarChar(100)
  patientContext Json?           @map("patient_context")
  signedAt      DateTime?        @map("signed_at") @db.Timestamp(6)
  signedBy      String?          @map("signed_by") @db.VarChar(255)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  form        Form        @relation(fields: [formId], references: [id])
  formVersion FormVersion @relation(fields: [formVersionId], references: [id])
  submittedBy User        @relation(fields: [submittedById], references: [id])

  @@index([tenantId, formId])
  @@index([tenantId, patientMrn])
  @@index([formVersionId])
  @@index([status])
  @@index([createdAt])
  @@map("submission")
}

// ─── AI Provider Config ─────────────────────────────────────────────────────

model AiProviderConfig {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  provider    String   @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  apiKey      String   @map("api_key") @db.Text
  model       String?  @db.VarChar(100)
  baseUrl     String?  @map("base_url") @db.VarChar(500)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([tenantId, provider], name: "uq_ai_provider_tenant")
  @@index([tenantId])
  @@map("ai_provider_config")
}

// ─── Form Asset ──────────────────────────────────────────────────────────────
// Binary assets referenced by a form version (logos, reference images). Scalar
// FKs (no relations) follow the log-table convention used by AuditLog.

model FormAsset {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  formVersionId String?  @map("form_version_id") @db.Uuid
  filename      String   @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  sizeBytes     Int      @map("size_bytes")
  checksum      String?  @db.VarChar(64)
  storageKey    String?  @map("storage_key") @db.VarChar(500)
  data          Bytes?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([tenantId])
  @@index([formVersionId])
  @@map("form_asset")
}

// ─── Conversion Job / Warning ────────────────────────────────────────────────
// Async PDF→form conversion tracking (Phase 6 consumes these). Persisted
// warnings ensure uncertain elements are never silently dropped.

model ConversionJob {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  formId          String?             @map("form_id") @db.Uuid
  status          ConversionJobStatus @default(PENDING)
  provider        String?             @db.VarChar(50)
  model           String?             @db.VarChar(100)
  sourceFileName  String?             @map("source_file_name") @db.VarChar(255)
  pageCount       Int?                @map("page_count")
  similarityScore Float?              @map("similarity_score")
  error           String?             @db.Text
  createdById     String              @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  completedAt     DateTime?           @map("completed_at") @db.Timestamp(6)

  warnings ConversionWarning[]

  @@index([tenantId, status])
  @@map("conversion_job")
}

model ConversionWarning {
  id              String   @id @default(uuid()) @db.Uuid
  conversionJobId String   @map("conversion_job_id") @db.Uuid
  type            String   @db.VarChar(50)
  message         String   @db.Text
  binding         String?  @db.VarChar(500)
  sourcePage      Int?     @map("source_page")
  confidence      Float?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  job ConversionJob @relation(fields: [conversionJobId], references: [id], onDelete: Cascade)

  @@index([conversionJobId])
  @@map("conversion_warning")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([tenantId, action])
  @@index([tenantId, resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── AI Usage ────────────────────────────────────────────────────────────────

// One row per LLM call (generate / refine / convert). Populated best-effort
// from the token usage each provider reports, and aggregated by the SUPER_ADMIN
// analytics console. Not tenant-query-scoped for domain reads; it is an
// operational metering table, but still carries tenantId/userId for attribution.
model AiUsage {
  id       BigInt  @id @default(autoincrement())
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  /// The form this spend belongs to, for per-form token reporting. Nullable
  /// and a log-style scalar (no FK, like audit_log) because: create-flows
  /// meter the LLM call BEFORE the form exists and backfill afterwards, a
  /// failed generation never gets a form at all, and usage history must
  /// survive the form being deleted.
  formId   String? @map("form_id") @db.Uuid

  provider     String   @db.VarChar(50)
  model        String   @db.VarChar(100)
  operation    String   @db.VarChar(50)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  totalTokens  Int      @default(0) @map("total_tokens")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([tenantId])
  @@index([userId])
  @@index([formId])
  @@index([createdAt])
  @@map("ai_usage")
}
